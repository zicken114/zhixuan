{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zhi-Xuan Studio",
  "version": "0.1.0",
  "identifier": "com.research.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Widget",
        "url": "index.html?window=widget",
        "width": 60,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "x": 100,
        "y": 100
      },
      {
        "label": "main",
        "title": "「知玄」- 知乎全场景悬浮创作舱",
        "url": "index.html?window=main",
        "width": 860,
        "height": 800,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "visible": true,
        "center": true
      },
      {
        "label": "popup",
        "title": "Quick Menu",
        "url": "index.html?window=popup",
        "width": 260,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "history",
        "title": "历史记录",
        "url": "index.html?window=history",
        "width": 400,
        "height": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "center": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "capture",
        "title": "Screen Capture",
        "url": "index.html?window=capture",
        "fullscreen": true,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "result",
        "title": "提取结果",
        "width": 480,
        "height": 360,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "url": "index.html?window=result",
        "visible": false
      },
      {
        "label": "sentinel_brief",
        "title": "文献简报",
        "width": 360,
        "height": 480,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "center": true,
        "url": "index.html?window=sentinel_brief",
        "visible": false
      },
      {
        "label": "experiment_snapshot",
        "title": "实验快照",
        "width": 320,
        "height": 420,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "center": true,
        "url": "index.html?window=experiment_snapshot",
        "visible": false
      },
      {
        "label": "review_wizard",
        "title": "文献综述生成",
        "width": 600,
        "height": 520,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "center": true,
        "url": "index.html?window=review_wizard",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
